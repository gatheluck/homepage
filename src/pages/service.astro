---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import EntryList from '@/components/EntryList.astro'
import Entry from '@/components/Entry.astro'
import { SHOW_TEASERS } from '@/consts'

const organizing = await getCollection('organizing')

// Standing affiliations carry no date, so the order is explicit rather than
// chronological; the id breaks ties so it never depends on iteration order.
const organizations = (await getCollection('organizations')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
)

/*
 * Sort by date (descending), falling back to the id only to guarantee a total
 * order when two entries really are on the same day.
 *
 * The tiebreak is deliberately neutral. Ordering by something invisible, such
 * as whether a role was held as primary organiser, makes the sequence
 * impossible to explain from what is on screen. Dates carry the order; record
 * the day in `date` when it is known, and precision sorts correctly against
 * month-only entries because the format is lexicographic.
 */
const sortedOrganizing = organizing.sort(
  (a, b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id)
)

// Group by type
const groupedByType = sortedOrganizing.reduce(
  (acc, item) => {
    const type = item.data.type
    if (!acc[type]) {
      acc[type] = []
    }
    acc[type].push(item)
    return acc
  },
  {} as Record<string, typeof organizing>
)

const typeOrder = ['workshop', 'conference', 'symposium', 'session', 'other']
const typeNames = {
  workshop: 'Workshop Organization',
  conference: 'Conference Organization',
  symposium: 'Symposium Organization',
  session: 'Session Chair',
  other: 'Other Activities',
}
---

<RootLayout
  title="Service & Organization - Yoshihiro Fukuhara"
  description="Academic service and organizing activities"
>
  <PageHeader
    title="Service & Organization"
    description="Workshop organization, conference activities, and academic service"
  />

  {
    typeOrder.map((type) => {
      const items = groupedByType[type]
      if (!items || items.length === 0) return null

      return (
        <SectionBlock title={typeNames[type as keyof typeof typeNames]}>
          <EntryList>
            {items.map((item) => (
              <Entry
                meta={item.data.date}
                label={item.data.role}
                labelAccent={item.data.isPrimary}
                title={item.data.title}
                href={item.data.url}
                teaser={SHOW_TEASERS.service}
                image={item.data.image}
                teaserSeed={item.id}
              >
                <p class="text-sm leading-6 text-fg-muted">{item.data.venue}</p>
                {item.data.description && (
                  <p class="measure text-sm leading-6 text-fg-subtle">{item.data.description}</p>
                )}
              </Entry>
            ))}
          </EntryList>
        </SectionBlock>
      )
    })
  }

  {
    organizations.length > 0 && (
      <SectionBlock title="Research Communities">
        <EntryList>
          {organizations.map((org) => (
            <Entry
              label={org.data.role}
              title={org.data.name}
              href={org.data.url}
              teaser={SHOW_TEASERS.service}
              image={org.data.logo}
              imageDark={org.data.logoDark ?? org.data.logo}
              teaserSeed={org.id}
              teaserFit="contain"
            >
              {org.data.description && (
                <p class="measure text-sm leading-6 text-fg-subtle">{org.data.description}</p>
              )}
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    organizing.length === 0 && (
      <p class="border-hairline text-fg-subtle border-t py-10 text-sm">
        No organizing activities yet.
      </p>
    )
  }
</RootLayout>
