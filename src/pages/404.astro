---
import Link from '@/components/Link.astro'
import { useTranslations } from '@/i18n'
import RootLayout from '@/layouts/RootLayout.astro'

const t = useTranslations()
---

<RootLayout title="Not Found" description="Page not found">
  <div
    class="flex flex-col items-start justify-start md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6"
  >
    <div class="pb-8 pt-6 md:space-y-5">
      <h1 class="display-title text-fg md:border-hairline text-7xl md:border-r md:px-6 md:text-8xl">
        404
      </h1>
    </div>
    <div class="max-w-md">
      <p class="section-title mb-3 text-2xl">
        {t('pages.404.title')}
      </p>
      <p class="mb-8 text-fg-muted">{t('pages.404.description')}</p>
      <Link
        href="/"
        class="border-hairline-strong text-accent hover:bg-accent hover:text-bg inline-block rounded-full border px-5 py-2 text-sm transition-colors"
      >
        {t('pages.404.backToHome')}
      </Link>
    </div>
  </div>
</RootLayout>
