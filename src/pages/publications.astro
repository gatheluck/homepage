---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import EntryList from '@/components/EntryList.astro'
import Entry from '@/components/Entry.astro'
import ResourceLinks from '@/components/ResourceLinks.astro'
import { AUTHOR_NAME, PUBLICATION_LINK_LABELS, SHOW_TEASERS } from '@/consts'
import { publicationUrl } from '@/functions'

const publications = await getCollection('publications')

// Group publications by category
const groupedPubs = publications.reduce(
  (acc, pub) => {
    const category = pub.data.category
    if (!acc[category]) {
      acc[category] = []
    }
    acc[category].push(pub)
    return acc
  },
  {} as Record<string, typeof publications>
)

// Sort within each category by year (descending)
Object.keys(groupedPubs).forEach((category) => {
  groupedPubs[category].sort((a, b) => b.data.year - a.data.year)
})

const categoryOrder = ['international', 'journal', 'preprint', 'domestic-reviewed', 'domestic']
const categoryNames = {
  international: 'International Conferences',
  journal: 'Journal Papers',
  preprint: 'Preprints',
  'domestic-reviewed': 'Domestic Conferences (Reviewed)',
  domestic: 'Domestic Conferences',
}

/** Emphasise the site owner among the co-authors, as is conventional on a publication list. */
function splitAuthors(authors: string) {
  return authors.split(AUTHOR_NAME)
}
---

<RootLayout
  title="Publications - Yoshihiro Fukuhara"
  description="Academic publications by Yoshihiro Fukuhara"
>
  <PageHeader title="Publications" description="Academic publications and research papers" />

  {
    categoryOrder.map((category) => {
      const pubs = groupedPubs[category]
      if (!pubs || pubs.length === 0) return null

      return (
        <SectionBlock title={categoryNames[category as keyof typeof categoryNames]}>
          <EntryList>
            {pubs.map((pub) => (
              <Entry
                meta={String(pub.data.year)}
                title={pub.data.title}
                href={publicationUrl(pub.data.links)}
                teaser={SHOW_TEASERS.publications}
                image={pub.data.image}
                teaserSeed={pub.id}
              >
                {/* prettier-ignore */}
                <p class="text-sm leading-6 text-fg-muted">
                  {splitAuthors(pub.data.authors).map((part, i) => (
                    <>{i > 0 && <span class="text-fg font-medium">{AUTHOR_NAME}</span>}{part}</>
                  ))}
                </p>
                <p class="text-sm leading-6 text-fg-subtle">{pub.data.venue}</p>
                {pub.data.notes && (
                  <p class="text-sm italic leading-6 text-fg-subtle">{pub.data.notes}</p>
                )}
                <ResourceLinks
                  links={(pub.data.links ?? []).map(({ type, url }) => ({
                    label: PUBLICATION_LINK_LABELS[type] ?? type,
                    url,
                  }))}
                />
              </Entry>
            ))}
          </EntryList>
        </SectionBlock>
      )
    })
  }
</RootLayout>
