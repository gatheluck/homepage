---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import Link from '@/components/Link.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import EntryList from '@/components/EntryList.astro'
import Entry from '@/components/Entry.astro'
import ResourceLinks from '@/components/ResourceLinks.astro'
import { useTranslations } from '@/i18n'

const t = useTranslations()

const author = (await getCollection('authors')).find((a) => a.id === 'default')
const publications = await getCollection('publications')
const positions = await getCollection('positions')
const talks = await getCollection('talks')
const awards = await getCollection('awards')
const organizing = await getCollection('organizing')
const allBlogPosts = await getCollection('blog')

// Sort and get latest items
const latestPublications = publications.sort((a, b) => b.data.year - a.data.year).slice(0, 3)
const currentPositions = positions
  .filter((p) => !p.data.endDate)
  .sort((a, b) => b.data.startDate.localeCompare(a.data.startDate))
const latestTalks = talks.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2)
const latestAwards = awards.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2)
const latestOrganizing = organizing
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2)
const latestBlogPosts = allBlogPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const researchInterests = [
  'Computer Vision',
  'Adversarial Robustness',
  'Neural Network Verification',
  'MLOps',
]

const socialLinks = [
  { label: 'GitHub', href: author?.data.github },
  { label: 'LinkedIn', href: author?.data.linkedin },
  { label: 'Twitter', href: author?.data.twitter },
].filter((link): link is { label: string; href: string } => Boolean(link.href))
---

<RootLayout title={t('siteMetadata.title')} description={t('siteMetadata.description')}>
  <!-- Hero -->
  <div class="flex flex-col gap-8 pb-10 pt-10 sm:flex-row sm:items-center sm:gap-10 sm:pt-14">
    {
      author?.data.avatar && (
        <img
          src={author.data.avatar}
          alt={author.data.name}
          class="h-28 w-28 shrink-0 rounded-full sm:h-32 sm:w-32"
        />
      )
    }
    <div class="min-w-0">
      <h1 class="display-title text-fg text-5xl sm:text-6xl">Hi, I'm Yoshihiro Fukuhara</h1>
      <p class="measure mt-4 text-lg leading-relaxed text-fg-muted">
        {author?.data.shortBio}
      </p>
      <p class="mt-3 text-sm text-fg-subtle">
        {researchInterests.join(' · ')}
      </p>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          socialLinks.map(({ label, href }) => (
            <Link href={href} class="link-subtle underline-offset-4 hover:underline">
              {label}
            </Link>
          ))
        }
      </div>
    </div>
  </div>

  {
    currentPositions.length > 0 && (
      <SectionBlock title="Current Positions">
        <EntryList>
          {currentPositions.map((pos) => (
            <Entry meta={`${pos.data.startDate} – Present`} title={pos.data.title}>
              <p class="text-sm leading-6 text-fg-muted">
                {pos.data.organizationUrl ? (
                  <Link
                    href={pos.data.organizationUrl}
                    class="decoration-hairline-strong hover:text-fg underline underline-offset-4 transition-colors"
                  >
                    {pos.data.organization}
                  </Link>
                ) : (
                  pos.data.organization
                )}
              </p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    latestPublications.length > 0 && (
      <SectionBlock
        title="Recent Publications"
        moreHref="/publications"
        moreLabel="All publications"
      >
        <EntryList>
          {latestPublications.map((pub) => (
            <Entry meta={String(pub.data.year)} title={pub.data.title}>
              <p class="text-sm leading-6 text-fg-subtle">{pub.data.venue}</p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    latestTalks.length > 0 && (
      <SectionBlock title="Recent Talks" moreHref="/talks" moreLabel="All talks">
        <EntryList>
          {latestTalks.map((talk) => (
            <Entry meta={talk.data.date} title={talk.data.title}>
              <p class="text-sm leading-6 text-fg-subtle">{talk.data.venue}</p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    latestAwards.length > 0 && (
      <SectionBlock title="Recent Awards">
        <EntryList>
          {latestAwards.map((award) => (
            <Entry meta={award.data.date} title={award.data.title}>
              <p class="text-sm leading-6 text-fg-subtle">{award.data.organization}</p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    latestOrganizing.length > 0 && (
      <SectionBlock title="Recent Service" moreHref="/service" moreLabel="All service activities">
        <EntryList>
          {latestOrganizing.map((org) => (
            <Entry meta={org.data.date} title={org.data.title}>
              <p class="text-sm leading-6 text-fg-subtle">
                {`${org.data.role} at ${org.data.venue}`}
              </p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    latestBlogPosts.length > 0 && (
      <SectionBlock title="Recent Writing" moreHref="/blog" moreLabel="All posts">
        <EntryList>
          {latestBlogPosts.map((post) => (
            <Entry
              meta={post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
              title={post.data.title}
              href={post.data.isExternal ? undefined : `/blog/${post.id}`}
            >
              <p class="measure text-sm leading-6 text-fg-subtle">{post.data.summary}</p>
              <ResourceLinks
                links={(post.data.externalLinks ?? [])
                  .slice()
                  .sort((a, b) => {
                    // Sort by language: en first, then others
                    if (a.language === 'en' && b.language !== 'en') return -1
                    if (a.language !== 'en' && b.language === 'en') return 1
                    return 0
                  })
                  .map((link) => ({
                    label: `${link.platform.charAt(0).toUpperCase()}${link.platform.slice(1)} (${link.language.toUpperCase()})`,
                    url: link.url,
                  }))}
              />
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }
</RootLayout>
