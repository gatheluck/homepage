---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import Link from '@/components/Link.astro'
import { useTranslations } from '@/i18n'

const t = useTranslations()

const author = (await getCollection('authors')).find((a) => a.id === 'default')
const publications = await getCollection('publications')
const positions = await getCollection('positions')
const talks = await getCollection('talks')
const awards = await getCollection('awards')
const organizing = await getCollection('organizing')
const allBlogPosts = await getCollection('blog')

// Sort and get latest items
const latestPublications = publications.sort((a, b) => b.data.year - a.data.year).slice(0, 3)
const currentPositions = positions
  .filter((p) => !p.data.endDate)
  .sort((a, b) => b.data.startDate.localeCompare(a.data.startDate))
const latestTalks = talks.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2)
const latestAwards = awards.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 2)
const latestOrganizing = organizing
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2)
const latestBlogPosts = allBlogPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const researchInterests = [
  'Computer Vision',
  'Adversarial Robustness',
  'Neural Network Verification',
  'MLOps',
]
---

<RootLayout title={t('siteMetadata.title')} description={t('siteMetadata.description')}>
  <!-- Hero Section -->
  <div class="space-y-6 pb-8 pt-6 md:space-y-8">
    <div class="flex flex-col items-center space-y-4 md:flex-row md:space-x-8 md:space-y-0">
      <div class="flex-shrink-0">
        {
          author?.data.avatar && (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              class="h-32 w-32 rounded-full md:h-40 md:w-40"
            />
          )
        }
      </div>
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 sm:text-4xl md:text-5xl">
          Hi, I'm Yoshihiro Fukuhara
        </h1>
        <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
          {author?.data.shortBio}
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-2 md:justify-start">
          {
            researchInterests.map((interest) => (
              <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                {interest}
              </span>
            ))
          }
        </div>
        <div class="mt-4 flex justify-center space-x-4 md:justify-start">
          {
            author?.data.github && (
              <Link
                href={author.data.github}
                class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              >
                GitHub
              </Link>
            )
          }
          {
            author?.data.linkedin && (
              <Link
                href={author.data.linkedin}
                class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              >
                LinkedIn
              </Link>
            )
          }
          {
            author?.data.twitter && (
              <Link
                href={author.data.twitter}
                class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              >
                Twitter
              </Link>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Current Positions -->
  {
    currentPositions.length > 0 && (
      <div class="border-t border-gray-200 py-8 dark:border-gray-700">
        <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-gray-100">Current Positions</h2>
        <div class="space-y-3">
          {currentPositions.map((pos) => (
            <div class="flex items-start space-x-3">
              <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                {pos.data.startDate} - Present
              </span>
              <div>
                <p class="font-medium text-gray-900 dark:text-gray-100">{pos.data.title}</p>
                {pos.data.organizationUrl ? (
                  <Link
                    href={pos.data.organizationUrl}
                    class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
                  >
                    {pos.data.organization}
                  </Link>
                ) : (
                  <p class="text-gray-600 dark:text-gray-400">{pos.data.organization}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- Latest Updates -->
  <div class="border-t border-gray-200 py-8 dark:border-gray-700">
    <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">Latest Updates</h2>

    <div class="space-y-6">
      <!-- Recent Publications -->
      {
        latestPublications.length > 0 && (
          <div>
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200">
              Recent Publications
            </h3>
            <ul class="space-y-2">
              {latestPublications.map((pub) => (
                <li class="text-gray-700 dark:text-gray-300">
                  <span class="font-medium">{pub.data.title}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400">
                    {' '}
                    - {pub.data.venue}, {pub.data.year}
                  </span>
                </li>
              ))}
            </ul>
            <div class="mt-3">
              <Link
                href="/publications"
                class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
              >
                View all publications →
              </Link>
            </div>
          </div>
        )
      }

      <!-- Recent Talks -->
      {
        latestTalks.length > 0 && (
          <div>
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200">
              Recent Talks
            </h3>
            <ul class="space-y-2">
              {latestTalks.map((talk) => (
                <li class="text-gray-700 dark:text-gray-300">
                  <span class="font-medium">{talk.data.title}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400"> - {talk.data.venue}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3">
              <Link
                href="/talks"
                class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
              >
                View all talks →
              </Link>
            </div>
          </div>
        )
      }

      <!-- Recent Awards -->
      {
        latestAwards.length > 0 && (
          <div>
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200">
              Recent Awards
            </h3>
            <ul class="space-y-2">
              {latestAwards.map((award) => (
                <li class="text-gray-700 dark:text-gray-300">
                  <span class="font-medium">{award.data.title}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400"> ({award.data.date})</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Recent Organizing Activities -->
      {
        latestOrganizing.length > 0 && (
          <div>
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200">
              Recent Organizing Activities
            </h3>
            <ul class="space-y-2">
              {latestOrganizing.map((org) => (
                <li class="text-gray-700 dark:text-gray-300">
                  <span class="font-medium">{org.data.title}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400">
                    {' '}
                    - {org.data.role} at {org.data.venue}
                  </span>
                </li>
              ))}
            </ul>
            <div class="mt-3">
              <Link
                href="/service"
                class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
              >
                View all service activities →
              </Link>
            </div>
          </div>
        )
      }

      <!-- Recent Blog Posts -->
      {
        latestBlogPosts.length > 0 && (
          <div>
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200">
              Recent Blog Posts
            </h3>
            <ul class="space-y-3">
              {latestBlogPosts.map((post) => (
                <li class="text-gray-700 dark:text-gray-300">
                  <div>
                    {post.data.isExternal ? (
                      <span class="font-medium">{post.data.title}</span>
                    ) : (
                      <Link
                        href={`/blog/${post.id}`}
                        class="font-medium hover:text-primary-500 dark:hover:text-primary-400"
                      >
                        {post.data.title}
                      </Link>
                    )}
                  </div>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{post.data.summary}</p>
                  {post.data.isExternal &&
                    post.data.externalLinks &&
                    post.data.externalLinks.length > 0 && (
                      <div class="mt-1 flex flex-wrap gap-2">
                        {post.data.externalLinks
                          .sort((a, b) => {
                            // Sort by language: en first, then others
                            if (a.language === 'en' && b.language !== 'en') return -1
                            if (a.language !== 'en' && b.language === 'en') return 1
                            return 0
                          })
                          .map((link) => (
                            <Link
                              href={link.url}
                              class="inline-flex items-center gap-1 text-xs text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                            >
                              <span class="capitalize">{link.platform}</span>
                              <span class="text-gray-500 dark:text-gray-400">
                                ({link.language.toUpperCase()})
                              </span>
                            </Link>
                          ))}
                      </div>
                    )}
                </li>
              ))}
            </ul>
            <div class="mt-3">
              <Link
                href="/blog"
                class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
              >
                View all blog posts →
              </Link>
            </div>
          </div>
        )
      }
    </div>
  </div>
</RootLayout>
