---
import { getEntry, render, getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import Link from '@/components/Link.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import EntryList from '@/components/EntryList.astro'
import Entry from '@/components/Entry.astro'
import ResourceLinks from '@/components/ResourceLinks.astro'

const author = await getEntry('authors', 'default')
if (!author) {
  return Astro.redirect('/404')
}
const { Content } = await render(author)

const awards = await getCollection('awards')
const books = await getCollection('books')
const certifications = await getCollection('certifications')

const sortedAwards = awards.sort((a, b) => b.data.date.localeCompare(a.data.date))
const sortedBooks = books.sort((a, b) => b.data.date.localeCompare(a.data.date))

const contactLinks = [
  { label: 'Email', href: author.data.email ? `mailto:${author.data.email}` : undefined },
  { label: 'GitHub', href: author.data.github },
  { label: 'LinkedIn', href: author.data.linkedin },
  { label: 'Twitter', href: author.data.twitter },
].filter((link): link is { label: string; href: string } => Boolean(link.href))
---

<RootLayout title="About - Yoshihiro Fukuhara" description={author.data.shortBio}>
  <PageHeader title="About" />

  <div
    class="items-start gap-x-12 border-hairline border-t py-10 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)]"
  >
    <aside class="mb-10 lg:mb-0 lg:sticky lg:top-10">
      {
        author.data.avatar && (
          <img
            src={author.data.avatar}
            alt={author.data.name}
            class="h-32 w-32 rounded-full lg:h-36 lg:w-36"
          />
        )
      }
      <h2 class="text-fg mt-5 text-lg font-medium">
        {author.data.name}
      </h2>
      <p class="mt-1 text-sm leading-6 text-fg-muted">
        {author.data.occupation}
      </p>
      <p class="text-sm leading-6 text-fg-subtle">{author.data.company}</p>
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          contactLinks.map(({ label, href }) => (
            <Link href={href} class="link-subtle underline-offset-4 hover:underline">
              {label}
            </Link>
          ))
        }
      </div>
    </aside>

    <div class="prose measure dark:prose-invert">
      <Content />
    </div>
  </div>

  {
    sortedAwards.length > 0 && (
      <SectionBlock title="Awards & Honors">
        <EntryList>
          {sortedAwards.map((award) => (
            <Entry meta={award.data.date} title={award.data.title}>
              <p class="text-sm leading-6 text-fg-muted">{award.data.organization}</p>
              {award.data.description && (
                <p class="measure text-sm leading-6 text-fg-subtle">{award.data.description}</p>
              )}
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    sortedBooks.length > 0 && (
      <SectionBlock title="Books & Book Chapters">
        <EntryList>
          {sortedBooks.map((book) => (
            <Entry meta={book.data.date} title={book.data.title}>
              {book.data.chapter && (
                <p class="text-sm leading-6 text-fg-muted">{book.data.chapter}</p>
              )}
              {book.data.pages && <p class="text-sm leading-6 text-fg-subtle">{book.data.pages}</p>}
              <ResourceLinks
                links={book.data.url ? [{ label: 'Details', url: book.data.url }] : []}
              />
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }

  {
    certifications.length > 0 && (
      <SectionBlock title="Certifications">
        <EntryList>
          {certifications.map((cert) => (
            <Entry meta={cert.data.date} title={cert.data.title}>
              <p class="text-sm leading-6 text-fg-muted">{cert.data.organization}</p>
            </Entry>
          ))}
        </EntryList>
      </SectionBlock>
    )
  }
</RootLayout>
