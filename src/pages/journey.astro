---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import Link from '@/components/Link.astro'
import PageHeader from '@/components/PageHeader.astro'

const positions = await getCollection('positions')

// Sort positions by start date (descending - most recent first)
const sortedPositions = positions.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate))

const typeLabels = {
  work: 'Work',
  education: 'Education',
  fellowship: 'Fellowship',
  internship: 'Internship',
}
---

<RootLayout
  title="Journey - Yoshihiro Fukuhara"
  description="Career journey and academic history of Yoshihiro Fukuhara"
>
  <PageHeader title="Journey" description="My career path and academic journey" />

  {
    /*
    A single hairline rail carries the sense of a timeline. It replaces the rows
    of cards, so this page has one line system rather than card borders, a rail
    and dividers all at once.
  */
  }
  <ol class="border-hairline border-t py-5">
    {
      sortedPositions.map((position) => {
        const isOngoing = !position.data.endDate
        const dateRange = isOngoing
          ? `${position.data.startDate} – Present`
          : `${position.data.startDate} – ${position.data.endDate}`

        return (
          <li class="relative grid grid-cols-1 gap-x-8 gap-y-1.5 border-hairline border-l py-5 pl-7 sm:grid-cols-[10.5rem_minmax(0,1fr)] sm:pl-9">
            <span
              class:list={[
                'absolute -left-[3.5px] top-[1.65rem] h-[7px] w-[7px] rounded-full',
                isOngoing ? 'bg-primary-600 dark:bg-primary-400' : 'bg-hairline-strong',
              ]}
              aria-hidden="true"
            />
            <div class="sm:pt-0.5">
              <div class="text-sm tabular-nums text-fg-subtle">{dateRange}</div>
              <div class="mt-0.5 text-xs uppercase tracking-wide text-fg-subtle">
                {typeLabels[position.data.type as keyof typeof typeLabels]}
              </div>
            </div>
            <div class="min-w-0">
              <h3 class="text-base font-semibold leading-6 text-fg">{position.data.title}</h3>
              <p class="mt-1.5 text-sm leading-6 text-fg-muted">
                {position.data.organizationUrl ? (
                  <Link
                    href={position.data.organizationUrl}
                    class="decoration-hairline-strong hover:text-fg underline underline-offset-4 transition-colors"
                  >
                    {position.data.organization}
                  </Link>
                ) : (
                  position.data.organization
                )}
              </p>
              {position.data.notes && position.data.notes.length > 0 && (
                <ul class="measure mt-2 space-y-1 text-sm leading-6 text-fg-subtle">
                  {position.data.notes.map((note) => (
                    <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-[3px] before:w-[3px] before:rounded-full before:bg-hairline-strong">
                      {note}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        )
      })
    }
  </ol>
</RootLayout>
