---
import { getCollection } from 'astro:content'
import { excludeDrafts } from '@/functions'
import PostLayout from '@/layouts/PostLayout.astro'
import SimpleLayout from '@/layouts/SimplePostLayout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', excludeDrafts)
  if (!posts) return []
  // Filter out external blog posts (they don't need individual pages)
  const internalPosts = posts.filter((post) => !post.data.isExternal)
  return internalPosts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, next: internalPosts[index + 1], prev: internalPosts[index - 1] },
  }))
}

const postLayout = Astro.props.post.data.postLayout
---

{postLayout === 'simple' ? <SimpleLayout {...Astro.props} /> : <PostLayout {...Astro.props} />}
