---
import { getCollection } from 'astro:content'
import RootLayout from '@/layouts/RootLayout.astro'
import Link from '@/components/Link.astro'
import PageHeader from '@/components/PageHeader.astro'
import EntryList from '@/components/EntryList.astro'
import Entry from '@/components/Entry.astro'
import ResourceLinks from '@/components/ResourceLinks.astro'
import { SHOW_TEASERS } from '@/consts'

const talks = await getCollection('talks')

// Sort talks by date (descending)
const sortedTalks = talks.sort((a, b) => b.data.date.localeCompare(a.data.date))

const typeLabels = {
  invited: 'Invited talk',
  tutorial: 'Tutorial',
  conference: 'Conference talk',
}
---

<RootLayout
  title="Talks - Yoshihiro Fukuhara"
  description="Presentations and talks by Yoshihiro Fukuhara"
>
  <PageHeader
    title="Talks & Presentations"
    description="Conference talks, invited lectures, and tutorials"
  />

  <div class="border-hairline border-t py-5">
    <EntryList>
      {
        sortedTalks.map((talk) => (
          <Entry
            meta={talk.data.date}
            label={typeLabels[talk.data.type as keyof typeof typeLabels]}
            title={talk.data.title}
            teaser={SHOW_TEASERS.talks}
            image={talk.data.coverImage}
            teaserSeed={talk.id}
          >
            <p class="text-sm leading-6 text-fg-muted">
              {talk.data.venueUrl ? (
                <Link
                  href={talk.data.venueUrl}
                  class="decoration-hairline-strong hover:text-fg underline underline-offset-4 transition-colors"
                >
                  {talk.data.venue}
                </Link>
              ) : (
                talk.data.venue
              )}
            </p>
            <ResourceLinks
              links={[
                ...(talk.data.slides ? [{ label: 'Slides', url: talk.data.slides }] : []),
                ...(talk.data.video ? [{ label: 'Video', url: talk.data.video }] : []),
              ]}
            />
          </Entry>
        ))
      }
    </EntryList>
  </div>
</RootLayout>
