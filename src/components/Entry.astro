---
import type { ImageMetadata } from 'astro'
import Link from './Link.astro'
import Teaser from './Teaser.astro'

/**
 * A single row of an EntryList.
 *
 * The left column carries the scannable metadata (date, kind). It is set in the
 * mono face, which is how the reference page treats technical values and which
 * also keeps the figures aligned down the page.
 *
 * The teaser sits at the trailing edge rather than between the metadata and the
 * title. With a leading thumbnail, an entry that has no image leaves a hole in
 * the middle of the row and pushes its text out of line with its neighbours; at
 * the trailing edge an empty cell is indistinguishable from the page margin.
 * That matters while most collections are still only partly illustrated.
 */
interface Props {
  /** Date, year or date range shown in the left column. */
  meta?: string
  /** Kind of item, e.g. "Invited talk". Rendered under the date. */
  label?: string
  /**
   * Draw the label in the accent colour to mark it out from its neighbours.
   *
   * The label text still has to say what it means on its own - the colour only
   * reinforces it, because WCAG 1.4.1 does not allow colour to be the sole
   * carrier of information.
   */
  labelAccent?: boolean
  title: string
  href?: string
  /** Reserve the trailing teaser column for this list. */
  teaser?: boolean
  /** Teaser image. When omitted and `teaser` is set, a placeholder is drawn. */
  image?: ImageMetadata
  /** Stable string used to vary the placeholder. Falls back to the title. */
  teaserSeed?: string
}

const {
  meta,
  label,
  labelAccent = false,
  title,
  href,
  teaser = false,
  image,
  teaserSeed,
} = Astro.props
const hasBody = Astro.slots.has('default')
---

<li class:list={['relative', href && 'group']}>
  {
    /*
      The hover surface sits behind the row and bleeds past it horizontally, so
      it reads as the row lifting rather than as a box appearing inside one.
      Only drawn for rows that are actually clickable.
    */
    href && (
      <div
        class="bg-surface-hover group-hover:shadow-glow ease-soft pointer-events-none absolute -inset-x-4 inset-y-0.5 rounded-xl opacity-0 transition-opacity duration-200 group-hover:opacity-100"
        aria-hidden="true"
      />
    )
  }
  <div
    class:list={[
      'row-box relative grid grid-cols-1 gap-x-8 gap-y-1.5 py-5',
      teaser
        ? 'sm:grid-cols-[10.5rem_minmax(0,1fr)_13rem]'
        : 'sm:grid-cols-[10.5rem_minmax(0,1fr)]',
    ]}
  >
    <div class="sm:pt-1">
      {meta && <div class="text-fg-subtle font-mono text-xs tabular-nums">{meta}</div>}
      {
        label && (
          <div
            class:list={[
              'mt-1 text-xs uppercase tracking-[0.12em]',
              labelAccent ? 'text-accent font-medium' : 'text-fg-subtle',
            ]}
          >
            {label}
          </div>
        )
      }
    </div>
    <div class="min-w-0">
      <h3 class="text-fg text-base font-medium leading-6">
        {
          href ? (
            <Link
              href={href}
              class="row-link group-hover:text-accent ease-soft underline-offset-4 transition-colors duration-200 group-hover:underline"
            >
              {title}
            </Link>
          ) : (
            title
          )
        }
      </h3>
      {
        hasBody && (
          <div class="mt-2 space-y-1.5">
            <slot />
          </div>
        )
      }
    </div>
    {
      teaser && (
        <div class="hidden sm:block sm:pt-1">
          <Teaser image={image} seed={teaserSeed ?? title} />
        </div>
      )
    }
  </div>
</li>
