---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import TeaserPlaceholder from './TeaserPlaceholder.astro'

/**
 * The trailing teaser thumbnail, shared by Entry and the blog list.
 *
 * Not a link of its own any more. The row it sits in carries a stretched link
 * covering the whole row, so the thumbnail is already clickable, and dropping
 * the separate anchor removes the duplicate destination that previously had to
 * be hidden from assistive technology with `aria-hidden` and `tabindex="-1"`.
 *
 * It responds to hover on the surrounding row rather than on itself, so the row
 * reacts as one thing.
 */
interface Props {
  image?: ImageMetadata
  /** Stable string used to vary the placeholder when there is no image. */
  seed: string
  class?: string
}

const { image, seed, class: className } = Astro.props

// Rendered at 208px wide in a 1024px container; 2x for high density displays.
const TEASER_WIDTH = 416
---

<div
  class:list={[
    'ring-hairline group-hover:ring-accent/50 aspect-teaser ease-soft overflow-hidden rounded-lg ring-1 transition duration-200',
    className,
  ]}
>
  {
    image ? (
      <Image
        src={image}
        alt=""
        width={TEASER_WIDTH}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="ease-soft h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
      />
    ) : (
      <TeaserPlaceholder
        seed={seed}
        class="ease-soft transition-transform duration-300 group-hover:scale-[1.04]"
      />
    )
  }
</div>
