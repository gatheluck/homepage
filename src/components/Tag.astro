---
import Link from './Link.astro'
import { type CollectionEntry, getEntry } from 'astro:content'

interface Props {
  tag?: CollectionEntry<'tags'>
  slug?: CollectionEntry<'tags'>['id']
}
let TagProp = Astro.props.tag

if (!TagProp && Astro.props.slug) {
  TagProp = await getEntry('tags', Astro.props.slug)
}
---

{
  TagProp && (
    <Link
      href={`/tags/${TagProp.id}`}
      class="border-hairline text-fg-muted hover:border-hairline-strong hover:text-accent inline-block rounded-full border px-2.5 py-0.5 text-xs transition-colors"
    >
      {TagProp.data.name}
    </Link>
  )
}
