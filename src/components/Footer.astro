---
import { SITE_METADATA } from '@/consts'
import Link from './Link.astro'
import { useTranslations } from '@/i18n'

const t = useTranslations()
---

<footer class="mt-20 border-t border-hairline">
  <div
    class="flex flex-col gap-2 py-8 text-sm text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      {`© ${new Date().getFullYear()} `}
      <Link href="/" class="link-subtle">{t('siteMetadata.title')}</Link>
    </p>
    <p>
      <Link href={SITE_METADATA.siteRepo} class="link-subtle underline-offset-4 hover:underline">
        Source on GitHub
      </Link>
    </p>
  </div>
</footer>
