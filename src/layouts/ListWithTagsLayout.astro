---
import { getCollection } from 'astro:content'
import { type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

import Link from '../components/Link.astro'
import Pagination from '../components/Pagination.astro'
import RootLayout from './RootLayout.astro'
import Tag from '../components/Tag.astro'
import ResourceLinks from '../components/ResourceLinks.astro'
import TeaserPlaceholder from '../components/TeaserPlaceholder.astro'
import FormattedDate from '../components/FormattedDate.astro'
import type { Page } from 'astro'
import { useTranslations } from '@/i18n'
import { SHOW_TEASERS } from '@/consts'

const t = useTranslations()

interface Props {
  title: string
  description: string
  titleTemplate?: string
  page: Page<CollectionEntry<'blog'>>
  robots?: string
}

const tags = await getCollection('tags')
const posts = await getCollection('blog')

function tagCount(id: CollectionEntry<'tags'>['id']) {
  if (!posts) return 0
  return posts.filter((post) => post.data.tags.some((ref) => ref.id === id)).length
}

function isSamePath(path: string) {
  return Astro.url.pathname === path
}

const { title, description, robots, page, titleTemplate } = Astro.props
const hasDefaultSlot = Astro.slots.has('default')
const isBlogPage = Astro.url.pathname.startsWith('/blog')
---

<RootLayout {title} {description} {robots} {titleTemplate}>
  <div>
    <div class="pb-10 pt-10 sm:pt-14">
      <h1 class="display-title text-fg text-5xl sm:text-6xl">
        {title}
      </h1>
      {
        hasDefaultSlot && (
          <div class="prose measure dark:prose-invert py-4">
            <slot />
          </div>
        )
      }
    </div>
    <div class="flex border-hairline border-t pt-5 sm:space-x-16">
      <div
        class="bg-surface hidden max-h-screen h-full sm:flex flex-wrap rounded-2xl p-6 min-w-[248px] max-w-[248px] overflow-auto"
      >
        <div>
          {
            isBlogPage ? (
              <h2 class="text-fg text-xs uppercase tracking-[0.12em]">
                {t('layouts.listWithTagsLayout.allPosts')}
              </h2>
            ) : (
              <Link
                href="/blog"
                class="text-fg-subtle hover:text-fg text-xs uppercase tracking-[0.12em]"
              >
                {t('layouts.listWithTagsLayout.allPosts')}
              </Link>
            )
          }
          <ul class="mt-4 space-y-2.5">
            {
              tags.map(({ id, data }) => (
                <li>
                  {isSamePath(`/tags/${id}`) ? (
                    <span class="text-sm font-medium text-fg">
                      {`${data.name} (${tagCount(id)})`}
                    </span>
                  ) : (
                    <Link
                      href={`/tags/${id}`}
                      class="link-subtle text-sm"
                      aria-label={`View posts tagged ${data.name}`}
                    >
                      {`${data.name} (${tagCount(id)})`}
                    </Link>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <ul class="-my-6 divide-y divide-hairline">
          {
            page.data.map(
              ({ id, data: { date, title, summary, tags, isExternal, externalLinks, cover } }) => (
                <li class="py-6">
                  <article
                    class:list={[
                      'grid grid-cols-1 gap-x-8',
                      SHOW_TEASERS.blog && 'sm:grid-cols-[minmax(0,1fr)_13rem]',
                    ]}
                  >
                    <div class="min-w-0">
                      <dl>
                        <dt class="sr-only">{t('layouts.listWithTagsLayout.publishedAt')}</dt>
                        <dd class="text-sm tabular-nums text-fg-subtle">
                          <FormattedDate date={date} />
                        </dd>
                      </dl>
                      <h3 class="section-title mt-2 text-2xl">
                        {isExternal ? (
                          <span class="text-fg">{title}</span>
                        ) : (
                          <Link
                            href={`/blog/${id}`}
                            class="text-fg hover:text-accent transition-colors"
                          >
                            {title}
                          </Link>
                        )}
                      </h3>
                      <p class="measure mt-2 text-sm leading-6 text-fg-muted">{summary}</p>
                      {isExternal && externalLinks && externalLinks.length > 0 && (
                        <ResourceLinks
                          links={externalLinks
                            .slice()
                            .sort((a, b) => {
                              // Sort by language: en first, then others
                              if (a.language === 'en' && b.language !== 'en') return -1
                              if (a.language !== 'en' && b.language === 'en') return 1
                              return 0
                            })
                            .map((link) => ({
                              label: `${link.platform.charAt(0).toUpperCase()}${link.platform.slice(1)} (${link.language.toUpperCase()})`,
                              url: link.url,
                            }))}
                          class="mt-3"
                        />
                      )}
                      <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1.5">
                        {tags.map(({ id }) => (
                          <Tag slug={id} />
                        ))}
                      </div>
                    </div>
                    {SHOW_TEASERS.blog && (
                      <div class="hidden sm:block">
                        <div class="ring-hairline aspect-teaser overflow-hidden rounded-lg ring-1">
                          {cover ? (
                            <Image
                              src={cover}
                              alt=""
                              width={416}
                              densities={[1, 2]}
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover"
                            />
                          ) : (
                            <TeaserPlaceholder seed={id} />
                          )}
                        </div>
                      </div>
                    )}
                  </article>
                </li>
              )
            )
          }
        </ul>
        {(page.url.next || page.url.prev) && <Pagination page={page} />}
      </div>
    </div>
  </div>
</RootLayout>
